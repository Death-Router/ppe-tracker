# Скопируйте этот файл в .env и заполните значения.
# .env в git не попадает (см. .gitignore).

# --- Обязательно ---
# Ключ подписи сессионных cookie. Без него приложение не запустится.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Окружение ---
# development | production
ENVIRONMENT=development

# Отправлять cookie только по HTTPS. Включайте в продакшене.
SESSION_COOKIE_SECURE=false

# --- PostgreSQL ---
# Внутри docker-compose хост называется db; при локальном запуске — localhost
POSTGRES_USER=ppe_user
POSTGRES_PASSWORD=ppe_password
POSTGRES_DB=ppe_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Первый администратор (для create_admin.py) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Фото сотрудников ---
# Каталог на томе (в docker смонтирован как ./data:/app/data) и предел размера
# загружаемого файла. Файлы в дамп не входят — бэкапьте каталог отдельно.
# PHOTO_DIR=data/photos
# PHOTO_MAX_MB=5
