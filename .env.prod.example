# Шаблон окружения для PROD (docker-compose.prod.yml).
# Скопируйте в .env.prod и заполните. Файл .env.prod в git не попадает.
#
# Секреты лучше держать не в файле рядом с проектом, а в секретах CI/оркестратора;
# файл — минимальный вариант для одного сервера.

# --- Обязательно ---
# Ключ подписи сессионных cookie. Без него приложение не запустится.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Окружение ---
ENVIRONMENT=production

# Cookie только по HTTPS. Включайте вместе с TLS на reverse-proxy,
# иначе браузер не пришлёт cookie и вход не сработает.
SESSION_COOKIE_SECURE=true

# Применять миграции при старте контейнера (alembic upgrade head).
# Для пустой базы ставьте 1 — схема разворачивается с нуля целиком.
AUTO_MIGRATE=0

# --- PostgreSQL ---
# POSTGRES_HOST не нужен: внутри compose хост называется db
POSTGRES_USER=ppe
POSTGRES_PASSWORD=
POSTGRES_DB=ppe_db

# --- Первый администратор (одноразово, для create_admin.py) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Фото сотрудников ---
# Каталог внутри контейнера; в docker-compose.prod.yml это том ppe_photos.
# В pg_dump фото не попадают — копируйте том отдельно (см. INSTALL.md, §9).
# PHOTO_DIR=data/photos
# PHOTO_MAX_MB=5
